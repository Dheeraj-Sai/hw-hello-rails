<% content_for :title, "Details about #{@movie.title}" %>

<div class="movie-card">
  <h2><%= @movie.title %></h2>

  <ul class="movie-meta-list">
    <li>
      <strong>Rating:</strong> <%= @movie.rating %>
    </li>
    <li>
      <strong>Released on:</strong> <%= @movie.release_date.strftime("%B %d, %Y") if @movie.release_date %>
    </li>
  </ul>

  <div class="movie-description-block">
    <h3>Description:</h3>
    <p><%= @movie.description %></p>
  </div>

  <div class="movie-actions">
    <%= link_to "Edit info", edit_movie_path(@movie), class: "button" %>
    <%= link_to "Back to movie list", movies_path, class: "button button-secondary" %>
    <%= button_to "Delete movie", @movie, method: :delete, data: { confirm: "Are you sure you want to delete #{@movie.title}?" }, class: "button-danger" %>
  </div>
</div>
