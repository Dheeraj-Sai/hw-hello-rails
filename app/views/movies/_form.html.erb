<%= form_with(model: movie, local: true) do |form| %>
  <% if movie.errors.any? %>
    <div class="errors-box">
      <h2><%= pluralize(movie.errors.count, "error") %> prohibited this movie from being saved:</h2>
      <ul>
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title, "Title" %>
    <%= form.text_field :title, class: "form-control", required: true, placeholder: "e.g. Star Wars" %>
  </div>

  <div class="form-group">
    <%= form.label :rating, "Rating" %>
    <%= form.select :rating, ['G', 'PG', 'PG-13', 'R', 'NC-17'], { prompt: 'Select a rating' }, { class: "form-control", required: true } %>
  </div>

  <div class="form-group">
    <%= form.label :release_date, "Released On" %>
    <%= form.date_field :release_date, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :description, "Description" %>
    <%= form.text_area :description, class: "form-control", rows: 4, placeholder: "Brief summary of the movie..." %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button" %>
    <%= link_to "Cancel", movies_path, class: "button button-secondary" %>
  </div>
<% end %>
